openapi: 3.0.3
info:
  title: ZenQRMenu API
  version: 1.0.0
  description: Restaurant QR Menu SaaS API
paths:
  /:
    get:
      operationId: root_retrieve
      description: Returns public restaurants with optional filtering and searching.
      summary: Restaurant List
      parameters:
      - in: query
        name: city
        schema:
          type: string
          minLength: 1
      - in: query
        name: country
        schema:
          type: string
          minLength: 1
      - in: query
        name: cuisine
        schema:
          type: string
          minLength: 1
      - in: query
        name: delivery
        schema:
          type: boolean
      - in: query
        name: dine_in
        schema:
          type: boolean
      - in: query
        name: latitude
        schema:
          type: number
          format: double
      - in: query
        name: longitude
        schema:
          type: number
          format: double
      - in: query
        name: ordering
        schema:
          enum:
          - name
          - -name
          - created_at
          - -created_at
          type: string
          default: name
          minLength: 1
        description: |-
          * `name` - name
          * `-name` - -name
          * `created_at` - created_at
          * `-created_at` - -created_at
      - in: query
        name: pickup
        schema:
          type: boolean
      - in: query
        name: search
        schema:
          type: string
      - in: query
        name: state
        schema:
          type: string
          minLength: 1
      security:
      - jwtAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RestaurantListResponse'
          description: ''
  /{restaurant_id}/delete/:
    delete:
      operationId: delete_destroy
      description: Soft delete a restaurant.
      summary: Delete Restaurant
      parameters:
      - in: path
        name: restaurant_id
        schema:
          type: integer
        required: true
      tags:
      - delete
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RestaurantDeleteResponse'
          description: ''
        '404':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RestaurantNotFound'
          description: ''
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
          description: ''
  /{restaurant_id}/update/:
    put:
      operationId: update_update
      description: |-
        Update restaurant.

        PATCH /api/restaurants/5/update/

        {
