components:
  schemas:
    ActionEnum:
      enum:
      - clock_in
      - clock_out
      - start_break
      - end_break
      type: string
      description: |-
        * `clock_in` - Clock In
        * `clock_out` - Clock Out
        * `start_break` - Start Break
        * `end_break` - End Break
    AuthenticationError:
      type: object
      properties:
        error:
          type: string
      required:
      - error
    DayOfWeekEnum:
      enum:
      - monday
      - tuesday
      - wednesday
      - thursday
      - friday
      - saturday
      - sunday
      type: string
      description: |-
        * `monday` - Monday
        * `tuesday` - Tuesday
        * `wednesday` - Wednesday
        * `thursday` - Thursday
        * `friday` - Friday
        * `saturday` - Saturday
        * `sunday` - Sunday
    DefaultPaymentGatewayEnum:
      enum:
      - razorpay
      - stripe
      - cash
      type: string
      description: |-
        * `razorpay` - Razorpay
        * `stripe` - Stripe
        * `cash` - Cash
    DeliveryStatusEnum:
      enum:
      - not_required
      - assigned
      - picked
      - out_for_delivery
      - delivered
      - failed
      type: string
      description: |-
        * `not_required` - Not Required
        * `assigned` - Assigned
        * `picked` - Picked
        * `out_for_delivery` - Out for Delivery
        * `delivered` - Delivered
        * `failed` - Failed
    EmailRequest:
      type: object
      description: Serializer for email input.
      properties:
        email:
          type: string
          format: email
          minLength: 1
      required:
      - email
    EmailVerificationRequired:
      type: object
      properties:
        error:
          type: string
        email:
          type: string
          format: email
      required:
      - email
      - error
    Error:
      type: object
      description: Generic error response serializer.
      properties:
        success:
          type: boolean
          default: false
        message:
          type: string
        error_code:
          type: string
      required:
      - message
    GoogleLoginRequest:
      type: object
      properties:
        token:
          type: string
          minLength: 1
      required:
      - token
    LoginRequest:
      type: object
      properties:
        username:
          type: string
          minLength: 1
          description: Username or email address
        password:
          type: string
          writeOnly: true
          minLength: 1
      required:
      - password
      - username
    LoginResponse:
      type: object
      properties:
        message:
          type: string
        access:
          type: string
        refresh:
          type: string
        user:
          $ref: '#/components/schemas/User'
      required:
      - access
      - message
      - refresh
      - user
    LogoutResponse:
      type: object
      properties:
        success:
          type: boolean
        message:
          type: string
      required:
      - message
      - success
    NearbyRestaurant:
      type: object
      description: |-
        Serializer used by the Nearby Restaurants API.

        GET /restaurants/nearby/

        Includes calculated distance from the customer.
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          readOnly: true
        about:
          type: string
          readOnly: true
        city:
          type: string
          readOnly: true
        state:
          type: string
          readOnly: true
          nullable: true
        country:
          type: string
          readOnly: true
        cuisine_type:
          type: string
          readOnly: true
        logo_url:
          type: string
          format: uri
          description: |-
            Return an absolute URL for the restaurant logo.

            If the serializer has access to the current request,
            build an absolute URL.

            Otherwise return the relative media URL.
          readOnly: true
        cover_image_url:
          type: string
          readOnly: true
        delivery_enabled:
          type: boolean
          readOnly: true
        pickup_enabled:
          type: boolean
          readOnly: true
        average_preparation_time:
          type: integer
          readOnly: true
          description: Minutes
        distance_km:
          type: number
          format: float
          readOnly: true
